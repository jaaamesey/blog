{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
        "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "paths": {
      "~/*": [
        "./src/*"
      ]
    },
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": [
      "astro/client",
      "react"
    ]
  },
  "include": [
    "src/**/*",
    "e2e/**/*",
    "playwright.config.ts",
    "worker-configuration.d.ts"
  ]
}
