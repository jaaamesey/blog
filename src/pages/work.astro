---
export const prerender = true;

import Layout from "~/layouts/Layout.astro";
---

<Layout title="work | bikeshedd.ing">
  <main class="text-center mx-auto p-4 flex flex-col items-center gap-2 overflow-x-hidden">
    <a href="/" class="text-start min-w-80">&lt;- back</a>
    <h1 class="max-6-xs text-2xl my-6">work</h1>
    <div class="grid gap-4 grid-cols-2">
      <span class="text-end">2026 - now</span>
      <a class="text-start" href="https://www.amber.com.au">amber electric</a>
      <span class="text-end">2020 - 2026</span>
      <a  class="text-start" href="https://www.canva.com">canva</a>
      <span class="text-end">2019 - 2020</span>
      <span class="text-start">airbike / terrapages</span>
    </div>
  </main>
</Layout>
